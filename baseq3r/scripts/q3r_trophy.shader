// Monument in the fountain of q3r_ctf_04 (tools/texbuild/build_models.py trophy()).
// Vertex lit like every misc_model; the bronze reflects a little.

models/mapobjects/q3r_trophy/bronze
{
	{
		map models/mapobjects/q3r_trophy/bronze.jpg
		rgbGen vertex
	}
	{
		map models/mapobjects/q3r_trophy/env.jpg
		tcGen environment
		blendFunc GL_ONE GL_ONE
		rgbGen vertex
	}
}

models/mapobjects/q3r_trophy/band
{
	{
		map models/mapobjects/q3r_trophy/band.jpg
		rgbGen vertex
	}
	{
		map models/mapobjects/q3r_trophy/env.jpg
		tcGen environment
		blendFunc GL_ONE GL_ONE
		rgbGen vertex
	}
}
